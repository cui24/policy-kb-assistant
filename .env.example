# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=policy_kb_l0

# Embedding model
EMBED_MODEL=BAAI/bge-large-zh-v1.5

# Chunk strategy for ingest: fixed | overlap | structured_hybrid
KB_CHUNK_STRATEGY=fixed
# fixed
KB_FIXED_CHUNK_SIZE=800
KB_FIXED_OVERLAP=0
# overlap
KB_OVERLAP_CHUNK_SIZE=800
KB_OVERLAP_OVERLAP=150
# structured_hybrid
KB_STRUCTURED_CHUNK_SIZE=800
KB_STRUCTURED_SECONDARY_OVERLAP=100
KB_STRUCTURED_MERGE_SHORT=260
KB_STRUCTURED_MIN_CHUNK=160
KB_STRUCTURED_SOFT_MAX_CHARS=520
KB_STRUCTURED_SHORT_AUGMENT_UNDER=180
KB_STRUCTURED_ALLOW_CROSS_ARTICLE_MERGE=1
# cross-page windowing (ingest)
KB_WINDOW_PAGES=1
KB_WINDOW_OVERLAP_PAGES=0
KB_WINDOW_MAX_CHARS=30000

# L2+ (Tickets/Audit DB)
DATABASE_URL=postgresql+psycopg2://policy:policy@localhost:5432/policy_kb
REDIS_URL=redis://localhost:6379/0
AUTO_MIGRATE_ON_STARTUP=true
DEV_DB_FALLBACK_CREATE_ALL=false
POLICY_API_BASE_URL=http://localhost:8080
POLICY_API_KEY=YOUR_POLICY_API_KEY
TICKET_DRAFT_TTL_MINUTES=20

# LLM (DeepSeek OpenAI-compatible)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=deepseek-chat
OPENAI_FALLBACK_MODEL=deepseek-chat
OPENAI_TIMEOUT_SECONDS=30

# Agent Graph -> MCP client（默认远程 MCP；本地开发可手动关闭）
AGENT_MCP_CLIENT_ENABLED=true
# Docker/集群内建议使用服务名；纯本机联调可改成 http://127.0.0.1:9000/mcp
AGENT_MCP_SERVER_URL=http://mcp:9000/mcp
AGENT_MCP_CLIENT_TIMEOUT_SECONDS=30
AGENT_AUTO_IDEMPOTENCY_WINDOW_SECONDS=60
AGENT_MCP_CHECK_ON_STARTUP=false
AGENT_MCP_STARTUP_STRICT=false
AGENT_MCP_HEALTHCHECK_TIMEOUT_SECONDS=5
AGENT_MCP_CIRCUIT_BREAKER_ENABLED=true
AGENT_MCP_CIRCUIT_FAIL_THRESHOLD=3
AGENT_MCP_CIRCUIT_OPEN_SECONDS=30

# MCP stdio demo（固定单用户）
MCP_ACTOR_USER_ID=demo_user
MCP_DEPARTMENT=IT
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_STREAMABLE_HTTP_PATH=/mcp
