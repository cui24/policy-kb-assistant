FROM python:3.10

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

COPY requirements-ui.txt /app/requirements-ui.txt

RUN python -m pip install --upgrade pip \
    && python -m pip install -r /app/requirements-ui.txt

COPY . /app

EXPOSE 8501

CMD ["streamlit", "run", "src/ui/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
