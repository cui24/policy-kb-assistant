# syntax=docker/dockerfile:1.7
FROM python:3.10

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG INSTALL_MCP=0
ARG INSTALL_DEV=0
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

COPY requirements.txt /app/requirements.txt
COPY requirements-mcp.txt /app/requirements-mcp.txt
COPY requirements-ui.txt /app/requirements-ui.txt
COPY requirements-dev.txt /app/requirements-dev.txt

RUN --mount=type=cache,id=pip-cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install --upgrade pip \
    && python -m pip install -r /app/requirements.txt \
    && if [ "$INSTALL_MCP" = "1" ]; then python -m pip install -r /app/requirements-mcp.txt; fi
RUN --mount=type=cache,id=pip-cache,target=/root/.cache/pip,sharing=locked \
    if [ "$INSTALL_DEV" = "1" ]; then python -m pip install -r /app/requirements-dev.txt; fi

COPY . /app

EXPOSE 8080

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
